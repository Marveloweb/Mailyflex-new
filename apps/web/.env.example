# Supabase project (Settings → API). The publishable/anon key is safe in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Must match the edge-function secrets of the same names.
VITE_HOSTED_DNS_ZONE=dns.mailyflex.com
VITE_RUA_DOMAIN=rua.mailyflex.com
VITE_TLSRPT_DOMAIN=tls.mailyflex.com
VITE_MTA_STS_TARGET=sts.dns.mailyflex.com
