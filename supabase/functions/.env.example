# Edge function secrets. Set in production with:  supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Optional, local development only. In production the functions check the Vault secret "cron_secret".
CRON_SECRET=
# Comma-separated origins allowed to call the functions from a browser.
ALLOWED_ORIGINS=https://app.mailyflex.com
APP_URL=https://app.mailyflex.com
MAIL_FROM=Maily Flex <alerts@mailyflex.com>

# Resend (resend.com): API key, and the signing secret of the email.received webhook.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Cloudflare zone that hosts customer records (DMARC/SPF/MTA-STS/TLS-RPT).
# Token needs Zone:DNS:Edit and Zone:SSL and Certificates:Edit (custom hostnames) on that zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
HOSTED_DNS_ZONE=dns.mailyflex.com
RUA_DOMAIN=rua.mailyflex.com
TLSRPT_DOMAIN=tls.mailyflex.com
MTA_STS_TARGET=sts.dns.mailyflex.com
