{
  "name": "mailyflex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "sync-core": "node scripts/sync-core.mjs",
    "check-core-sync": "node scripts/sync-core.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0",
    "vitest": "^3.2.4"
  }
}
